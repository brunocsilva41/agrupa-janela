<Window x:Class="AgrupaJanela.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grupo" Width="1200" Height="750" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="12.5">
  <DockPanel>
    <!-- Barra do grupo -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,4">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton x:Name="SaveToggle" Style="{StaticResource Segment}" Checked="Save_Changed" Unchecked="Save_Changed"
                        ToolTip="Salvar este grupo: layout e apps são lembrados e podem ser reabertos depois">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SaveIcon" Style="{StaticResource IconText}" Text="&#xE734;"/>
              <TextBlock x:Name="SaveLabel" Text="Salvar" Margin="6,0,0,0"/>
            </StackPanel>
          </ToggleButton>
          <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="NewGroup_Click"
                  ToolTip="Abrir outro grupo vazio para juntar outras janelas" AutomationProperties.Name="Novo grupo">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE78B;"/>
              <TextBlock x:Name="NewGroupLabel" Text="Novo grupo" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Padding="10,3" Click="Add_Click"
                  ToolTip="Adicionar uma janela aberta. Dica: arraste qualquer janela sobre o grupo segurando Shift.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE710;"/>
              <TextBlock Text="Adicionar" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="NameBox" MinWidth="90" MaxWidth="220" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0"
                   ToolTip="Nome do grupo (clique para editar)" ToolTipService.ShowsToolTipOnKeyboardFocus="False" TextChanged="Name_Changed"/>

          <Border Background="{StaticResource Bg}" CornerRadius="5" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="GridModeButton" GroupName="mode" IsChecked="True" Checked="Mode_Checked" ToolTip="Painéis lado a lado">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconText}" Text="&#xF0E2;"/>
                  <TextBlock Text="Grade" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="TabsModeButton" GroupName="mode" Checked="Mode_Checked" ToolTip="Uma janela por aba">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconText}" Text="&#xE7C4;"/>
                  <TextBlock Text="Abas" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>

          <Rectangle Width="1" Fill="{StaticResource Line}" Margin="10,3"/>
          <TextBlock x:Name="LayoutLabel" Text="Layout" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <StackPanel x:Name="PresetPanel" Orientation="Horizontal"/>
          <!-- Janela estreita (abaixo de 680 DIP): os 5 layouts viram este menu -->
          <Button x:Name="LayoutMenuButton" Style="{StaticResource GhostButton}" Content="Layout ▾" Visibility="Collapsed"
                  Click="LayoutMenu_Click" ToolTip="Escolher o layout dos painéis"/>
          <Button Style="{StaticResource GhostButton}" Click="Equalize_Click" ToolTip="Igualar: deixa todos os painéis do mesmo tamanho"
                  AutomationProperties.Name="Igualar">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;"/>
              <TextBlock x:Name="EqualizeLabel" Text="Igualar" Margin="6,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Linha de status: só aparece com mensagem. Sucesso some sozinho; erro fica até o ✕. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="24" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,0,4,0" Visibility="Collapsed">
      <DockPanel>
        <Button x:Name="StatusClose" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,0,6,0" Focusable="False"
                Visibility="Collapsed" ToolTip="Fechar o aviso" AutomationProperties.Name="Fechar o aviso" Click="StatusClose_Click">
          <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE8BB;"/>
        </Button>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextDim}"/>
      </DockPanel>
    </Border>

    <Grid>
      <ContentControl x:Name="ContentArea" Focusable="False" Margin="4"/>
      <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Grupo vazio" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Foreground="{StaticResource TextDim}" Margin="0,6,0,0" TextAlignment="Center" LineHeight="20">
          Clique em <Bold>Adicionar</Bold>, arraste uma janela até aqui segurando <Bold>Shift</Bold>,<LineBreak/>
          ou use o atalho de agrupar em qualquer janela.
        </TextBlock>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
